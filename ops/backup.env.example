DATA_DIR=/var/lib/bojin
BACKUP_ROOT=/var/backups/bojin
# Dedicated SSH destination, private to the operator. No credentials here.
# OFFSITE_DEST=backup-user@backup-host:/private/lean-ritual

BACKUP_RETENTION_DAYS=7
# Optional: alert via /usr/local/libexec/bojin-alert (ALERT_URL) when disk reaches this %.
# BACKUP_DISK_WARN_PERCENT=80
