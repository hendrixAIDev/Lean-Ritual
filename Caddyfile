# 把 bojin.example.com 换成你的域名；Caddy 会自动申请并续期 HTTPS 证书
bojin.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:8080 {
		# 应用重启或更新的几秒里，先等它回来再转发，而不是立刻给用户报错。
		# 连接不上时请求还没发出去，所以重试不会重复写入数据。
		lb_try_duration 15s
		lb_try_interval 500ms
	}
	# 应用暂时连不上（例如更新时的备份窗口）：给友好提示，而不是空白的 502。
	# 只处理 Caddy 自己连不上应用的情况；应用自己返回的错误原样转发。
	handle_errors {
		@unavailable expression `{err.status_code} >= 502 && {err.status_code} <= 504`
		handle @unavailable {
			header Cache-Control "no-store"
			header Retry-After "10"
			handle /api/* {
				header Content-Type "application/json; charset=utf-8"
				respond `{"error":"maintenance","message":"服务器正在重启或更新，请稍后再试"}` 503
			}
			handle {
				header Content-Type "text/html; charset=utf-8"
				respond `<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="10"><title>薄肌日课</title></head><body style="font-family:system-ui,sans-serif;text-align:center;padding:4em 1em;color:#333;background:#fafafa"><h1 style="font-size:1.3em">薄肌日课正在更新</h1><p>你的记录都在，页面会在几秒后自动刷新。</p></body></html>` 503
			}
		}
	}
}
