[Unit]
Description=Bojin Rike
After=network.target

[Service]
User=bojin
WorkingDirectory=/opt/bojin
EnvironmentFile=/opt/bojin/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
