# 复制成 .env 后按需修改（.env 里有密钥，不要提交到 git）
PORT=8080
HOST=127.0.0.1
DATA_DIR=/var/lib/bojin
# 服务器上的 OpenRouter 密钥：所有用户的 AI 都走它，费用记在你的 OpenRouter 账户
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_DAILY_LIMIT=60
# 1 = 开放注册；0 = 关闭（只能用命令行建账号）
ALLOW_SIGNUP=1
# 填了就必须输入邀请码才能注册，防止陌生人刷你的 AI 额度
INVITE_CODE=
# 走 HTTPS（Caddy/Nginx 在前面）时都设为 1
COOKIE_SECURE=1
TRUST_PROXY=1
