# Copy to .env; use node --env-file=.env server.js or systemd EnvironmentFile.
HOST=127.0.0.1
PORT=8080
DATA_DIR=/var/lib/bojin
AUTH_BASE_URL=https://bojin.example.com
# Generate a unique random secret (at least 32 characters); never commit it.
AUTH_SECRET=
COOKIE_SECURE=1
# Only enable behind a trusted reverse proxy; do not expose the Node port publicly.
TRUST_PROXY=1
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional AI: leaving key empty keeps manual logging available.
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_DAILY_LIMIT=60
# Request caps are not dollar budgets; also configure provider billing controls.
AI_GLOBAL_DAILY_LIMIT=300
AI_MAX_OUTPUT_TOKENS=2000

# Photo quotas (normalized images), UTC upload attempt limit
PHOTO_USER_BYTES=262144000
PHOTO_TOTAL_BYTES=5368709120
PHOTO_DAILY_LIMIT=60
