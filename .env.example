# Copy to .env; use node --env-file=.env server.js or systemd EnvironmentFile.
HOST=127.0.0.1
PORT=8080
DATA_DIR=/var/lib/bojin
# Optional: approved landing-page videos. Unset (default) hides the video section completely.
# Do not set it until approved cuts exist; see "Landing-page media" in docs/OPERATIONS.md.
# MEDIA_DIR=/var/lib/bojin-media
# Optional: availability-check cache TTL in milliseconds (default 30000; integer 1..300000).
# MEDIA_CHECK_TTL_MS=30000
AUTH_BASE_URL=https://bojin.example.com
# Generate a unique random secret (at least 32 characters); never commit it.
AUTH_SECRET=
COOKIE_SECURE=1
# Only enable behind a trusted reverse proxy; do not expose the Node port publicly.
TRUST_PROXY=1
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional Reply-To address for transactional emails (defaults to hendrix.ai.dev@gmail.com).
MAIL_REPLY_TO=hendrix.ai.dev@gmail.com
# Optional AI: leaving the active provider's key empty keeps manual logging available.
# AI_PROVIDER: openrouter (default) or gemini (direct Google Gemini API with optional OpenRouter backup).
AI_PROVIDER=openrouter
# Direct Google Gemini API (AI Studio key; used when AI_PROVIDER=gemini; GEMINI_BASE must stay on https://generativelanguage.googleapis.com).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter (primary when AI_PROVIDER=openrouter; automatic single-retry backup on Gemini 5xx/UNAVAILABLE/429/timeout errors when key is set; OPENROUTER_BASE must stay on https://openrouter.ai).
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
# Default OpenRouter model uses google/gemini-3.8-flash (google/gemini-2.5-flash retires 2026-12-01 on OpenRouter).
OPENROUTER_MODEL=google/gemini-3.8-flash
AI_DAILY_LIMIT=60
AI_GLOBAL_DAILY_LIMIT=300
# Monthly estimated USD budget caps (UTC calendar month; 0 disables AI).
# At 80% global spend one phone alert is sent via ALERT_URL; at 100% AI pauses globally and alerts once.
AI_USER_MONTHLY_USD=5
AI_GLOBAL_MONTHLY_USD=80
# Optional pricing overrides (USD per 1M tokens; defaults: gemini-3.8-flash 0.75/3.75 through 2026-12-31 UTC,
# automatically stepping to standard undiscounted 1.50/7.50 starting 2027-01-01 UTC; reasoning billed as output).
# AI_INPUT_PRICE_PER_1M=0.75
# AI_OUTPUT_PRICE_PER_1M=3.75
# AI_GEMINI_INPUT_PRICE_PER_1M=
# AI_GEMINI_OUTPUT_PRICE_PER_1M=
# AI_OPENROUTER_INPUT_PRICE_PER_1M=
# AI_OPENROUTER_OUTPUT_PRICE_PER_1M=
# AI_MODEL_PRICES_JSON={"gemini-3.8-flash":{"inputPer1M":0.75,"outputPer1M":3.75},"google/gemini-3.8-flash":{"inputPer1M":0.75,"outputPer1M":3.75}}
# Optional explicit billed-output token ceiling required only for custom models outside built-in Gemini Flash routes (unknown routes pause AI fail-closed).
# AI_MAX_BILLED_OUTPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=2000
# Optional reasoning effort for reasoning models (unset = do not send; allowed: low, medium, high).
AI_REASONING_EFFORT=

# Photo quotas (normalized images), UTC upload attempt limit
PHOTO_USER_BYTES=262144000
PHOTO_TOTAL_BYTES=5368709120
PHOTO_DAILY_LIMIT=60

# 每个账号的文档总字节数、条数与每分钟写入次数（正整数）
DOC_USER_BYTES=52428800
DOC_USER_COUNT=20000
DOC_WRITE_PER_MIN=240

# Tester feedback daily limits (UTC) and optional HTTPS ntfy alert URL
FEEDBACK_DAILY_LIMIT=10
FEEDBACK_GLOBAL_DAILY_LIMIT=100
ALERT_URL=
